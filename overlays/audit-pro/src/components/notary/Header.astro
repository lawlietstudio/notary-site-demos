---
import LogoMark from './LogoMark.astro';
import { en, nav, site, withBase } from '../../lib/site';

const { path = '/' } = Astro.props;
---
<header class="bg-white py-4 border-b border-gray-100">
  <div class="container mx-auto max-w-7xl px-4">
    <div class="flex items-center justify-between gap-4">
      <a href={withBase('/')} class="flex items-center gap-2 text-orange-500 text-xl md:text-2xl font-bold">
        <LogoMark class="h-8 w-8 shrink-0 text-gray-800" />
        {site.name}
      </a>

      <nav class="hidden md:flex space-x-8" aria-label="Main">
        {nav.map((n) => (
          <a
            href={withBase(n.href)}
            aria-current={n.href === path ? 'page' : undefined}
            class="text-gray-600 hover:text-gray-900 aria-[current=page]:text-gray-900 aria-[current=page]:font-medium"
          >{n.label}</a>
        ))}
      </nav>

      <a
        href={withBase('/contact/')}
        class="hidden sm:inline-flex bg-orange-500 hover:bg-orange-600 text-white rounded-md px-5 py-2.5 text-sm font-medium"
      >{en(site.cta.book)}</a>
    </div>

    <nav class="md:hidden mt-3 flex gap-6 overflow-x-auto text-sm" aria-label="Main (mobile)">
      {nav.map((n) => (
        <a
          href={withBase(n.href)}
          aria-current={n.href === path ? 'page' : undefined}
          class="whitespace-nowrap text-gray-600 aria-[current=page]:text-gray-900 aria-[current=page]:font-medium"
        >{n.label}</a>
      ))}
    </nav>
  </div>
</header>
