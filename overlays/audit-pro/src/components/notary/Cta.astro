---
import { en, site, withBase } from '../../lib/site';
---
<section class="py-16 bg-gradient-to-r from-orange-100 to-blue-100 px-4">
  <div class="container mx-auto max-w-7xl text-center">
    <h2 class="text-3xl font-bold text-gray-800 mb-6">
      <span class="marker-underline">{en(site.ctaBand.title)}</span>
    </h2>
    <p class="text-lg text-gray-700 mb-8 max-w-3xl mx-auto">{en(site.ctaBand.text)}</p>
    <a
      href={withBase('/contact/')}
      class="inline-flex bg-orange-500 hover:bg-orange-600 text-white px-8 py-4 rounded-md font-medium"
    >{en(site.cta.book)}</a>
  </div>
</section>
