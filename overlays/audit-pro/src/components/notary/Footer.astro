---
import LogoMark from './LogoMark.astro';
import { en, nav, site, telHref, withBase } from '../../lib/site';

const year = new Date().getFullYear();
---
<footer class="bg-gray-100 py-16">
  <div class="container mx-auto max-w-7xl px-4">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-10">
      <div class="md:col-span-2">
        <div class="flex items-center gap-2 text-orange-500 text-2xl font-bold mb-4">
          <LogoMark class="h-8 w-8 shrink-0 text-gray-800" />
          {site.name}
        </div>
        <p class="text-gray-600 max-w-sm">{site.metaDescription}</p>
      </div>

      <div>
        <h3 class="text-lg font-medium text-gray-800 mb-4">Explore</h3>
        <ul class="space-y-3">
          {nav.map((n) => <li><a href={withBase(n.href)} class="text-gray-600 hover:text-gray-900">{n.label}</a></li>)}
          <li><a href={withBase('/privacy/')} class="text-gray-600 hover:text-gray-900">Privacy Policy</a></li>
        </ul>
      </div>

      <div>
        <h3 class="text-lg font-medium text-gray-800 mb-4">Contact us</h3>
        <ul class="space-y-3 text-gray-600">
          <li><a href={telHref(site.phone)} class="hover:text-gray-900">{site.phone}</a></li>
          <li><a href={`mailto:${site.email}`} class="hover:text-gray-900">{site.email}</a></li>
          <li>{en(site.hours.label)}</li>
        </ul>
      </div>
    </div>

    <p class="mt-12 border-t border-gray-200 pt-6 text-sm text-gray-500">© {year} {site.name}</p>
  </div>
</footer>
