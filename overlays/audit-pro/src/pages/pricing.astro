---
import Layout from '../layouts/main.astro';
import PriceCards from '../components/notary/PriceCards.astro';
import Cta from '../components/notary/Cta.astro';
import { FileText } from 'lucide-react';
import { en, site } from '../lib/site';
---
<Layout
  path="/pricing/"
  title="Price Plans"
  description={`Transparent mobile notary prices: ${site.pricing.plans.map((p: any) => `${en(p.name)} ${p.price}`).join(', ')}.`}
>
  <section class="bg-gradient-to-r from-indigo-50 to-blue-50 py-16 px-4 text-center">
    <div class="container mx-auto max-w-3xl">
      <h1 class="text-3xl md:text-5xl font-bold text-gray-800 mb-4">
        <span class="marker-underline">{en(site.pricing.title)}</span>
      </h1>
      <p class="text-lg text-gray-700">{en(site.pricing.payment)}</p>
    </div>
  </section>

  <section class="py-16 px-4">
    <PriceCards />
  </section>

  <section class="bg-gray-50 py-16 px-4">
    <div class="container mx-auto max-w-7xl">
      <h2 class="text-3xl font-bold text-center text-gray-800 mb-12">{en(site.pricing.examplesTitle)}</h2>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {site.services.items.map((s: any) => (
          <div class="rounded-xl border border-gray-200 bg-white p-6">
            <FileText className="mb-4 h-7 w-7 text-orange-500" />
            <h3 class="text-lg font-semibold text-gray-800 mb-2">{en(s.name)}</h3>
            <p class="text-gray-600">{en(s.example)}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <Cta />
</Layout>
