---
import Layout from '../layouts/main.astro';
import { withBase } from '../lib/site';
---
<Layout path="/404/" title="Page not found">
  <section class="py-24 px-4 text-center">
    <h1 class="text-4xl font-bold text-gray-800 mb-4">Page not found</h1>
    <p class="text-gray-600 mb-8">The page you were looking for does not exist.</p>
    <a href={withBase('/')} class="inline-flex bg-orange-500 hover:bg-orange-600 text-white px-8 py-4 rounded-md font-medium">Back to home</a>
  </section>
</Layout>
