{
  "name": "lawyer-web",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Astro website for a mobile notary public service, with content managed in Sanity",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "seed": "node scripts/make-seed.mjs",
    "studio": "npm --prefix studio run dev",
    "studio:deploy": "npm --prefix studio run deploy",
    "pages:build": "node scripts/build-pages.mjs",
    "pages:preview": "node scripts/preview-pages.mjs 4400 notary-site-demos",
    "pages:check": "node scripts/check-links.mjs http://localhost:4400/notary-site-demos/",
    "variant:screwfast": "node variants/run.mjs screwfast",
    "variant:astrowind": "node variants/run.mjs astrowind",
    "variant:audit": "node scripts/prepare-audit.mjs && node variants/run.mjs audit-pro",
    "variant:molique": "node scripts/prepare-molique.mjs && node variants/run.mjs molique-site"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@sanity/client": "^8.17.0",
    "astro": "^7.4.13"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22.23.4"
  }
}
