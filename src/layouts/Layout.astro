---
import '@fontsource-variable/inter';
import '@fontsource-variable/source-serif-4';
import '../styles/global.css';
import LogoMark from '../components/LogoMark.astro';
import { getSite } from '../lib/content';
import { locale, nav } from '../lib/config';
import { en, telHref, withBase } from '../lib/helpers';

interface Props {
  path: string;
  title: string;
  description: string;
  jsonld?: Record<string, unknown>;
  noindex?: boolean;
}

const { path, title, description, jsonld, noindex = false } = Astro.props;
const site = await getSite();

const url = new URL(path, site.siteUrl).href;
const fullTitle = path === '/' ? `${site.name} – ${site.homeTitle}` : `${title} – ${site.name}`;
const tel = telHref(site.phone);
const year = new Date().getFullYear();
// Preview deployments (PUBLIC_DEMO=1) must not be indexed or claim a canonical URL.
const demo = import.meta.env.PUBLIC_DEMO === '1';
---
<!doctype html>
<html lang={locale.split('-')[0]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#13233f" />
    <meta name="robots" content={noindex || demo ? 'noindex, nofollow' : 'index, follow'} />
    {!demo && <link rel="canonical" href={url} />}
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {!demo && <meta property="og:url" content={url} />}
    <meta name="twitter:card" content="summary" />
    <script is:inline>document.documentElement.classList.add('js')</script>
    {jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld).replace(/</g, '\\u003c')} />}
  </head>
  <body>
    <a class="skip" href="#main">Skip to main content</a>
    <header class="site-header">
      <div class="wrap header-inner">
        <a class="brand" href={withBase('/')}><LogoMark class="brand-mark" size={34} />{site.name}</a>
        <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav" aria-label="Menu"><span></span></button>
        <nav id="site-nav" class="site-nav" aria-label="Main">
          {nav.map((n) => <a href={withBase(n.href)} aria-current={n.href === path ? 'page' : undefined}>{n.label}</a>)}
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap footer-grid">
        <div>
          <p class="footer-brand"><LogoMark class="footer-mark" size={30} />{site.name}</p>
          <p class="muted-on-dark">{en(site.hours.label)}</p>
        </div>
        <div>
          <p class="footer-head">Contact us</p>
          <p><a href={tel}>{site.phone}</a><br /><a href={`mailto:${site.email}`}>{site.email}</a></p>
        </div>
        <div>
          <p class="footer-head">Explore</p>
          <p>
            {nav.map((n) => <><a href={withBase(n.href)}>{n.label}</a><br /></>)}
            <a href={withBase('/privacy/')}>Privacy Policy</a>
          </p>
        </div>
      </div>
      <div class="wrap footer-base">© {year} {site.name}</div>
    </footer>

    <script>
      // Progressive enhancement only: the site works without JavaScript.

      // Mobile menu
      const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
      const nav = document.getElementById('site-nav');
      if (toggle && nav) {
        const setOpen = (open: boolean) => {
          toggle.setAttribute('aria-expanded', String(open));
          nav.dataset.open = String(open);
        };
        toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
            setOpen(false);
            toggle.focus();
          }
        });
      }

      // Contact form: with no form endpoint configured, compose a tidy mailto: message.
      const form = document.querySelector<HTMLFormElement>('#contact-form');
      const mailto = form?.dataset.mailto;
      if (form && mailto) {
        form.addEventListener('submit', (e) => {
          e.preventDefault();
          const v = (name: string) =>
            ((form.elements.namedItem(name) as HTMLInputElement | null)?.value ?? '').trim();
          const lines = [
            v('message'),
            '',
            `Name: ${v('first-name')} ${v('last-name')}`.trim(),
            `Email: ${v('email')}`,
          ];
          if (v('phone')) lines.push(`Phone: ${v('phone')}`);
          const subject = v('subject') || 'Appointment enquiry';
          window.location.href =
            `mailto:${mailto}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(lines.join('\n'))}`;
          const status = form.querySelector<HTMLElement>('.form-status');
          if (status) status.textContent = status.dataset.success ?? '';
        });
      }
    </script>
  </body>
</html>
