---
// Responsive photo: AVIF + WebP at several widths, generated at build time.
import { Picture } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt: string;
  class?: string;
  sizes?: string;
  widths?: number[];
  eager?: boolean;
}

const {
  src,
  alt,
  class: className,
  sizes = '100vw',
  widths = [480, 800, 1200, 1600],
  eager = false,
} = Astro.props;
---
<Picture
  src={src}
  alt={alt}
  class={className}
  formats={['avif', 'webp']}
  widths={widths}
  sizes={sizes}
  loading={eager ? 'eager' : 'lazy'}
  fetchpriority={eager ? 'high' : 'auto'}
/>
