---
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
import '@fontsource-variable/instrument-sans';
import '@fontsource/noto-serif-tc/400.css';
import '@fontsource/noto-sans-tc/400.css';
import '../styles/site.css';
import Bi from '../components/Bi.astro';
import LogoMark from '../components/LogoMark.astro';
import { en, nav, site, telHref, withBase, zh } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  path?: string;
}

const { title, description = site.metaDescription, path = '/' } = Astro.props;
const fullTitle = title ? `${title} – ${site.name}` : `${site.name} – ${site.homeTitle}`;
// Preview deployments (PUBLIC_DEMO=1) must not be indexed.
const robots = import.meta.env.PUBLIC_DEMO === '1' ? 'noindex, nofollow' : 'index, follow';
const vendor = withBase('/vendor/molique');
const year = new Date().getFullYear();
---
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#0a1226" />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="stylesheet" href={`${vendor}/css/molique-style.min.css`} />
    <script is:inline>
      // This design is light-only: lock the theme so molique does not switch to its dark palette.
      try { localStorage.setItem('molique-theme', 'light'); } catch (e) {}
      document.documentElement.setAttribute('data-theme', 'light');
    </script>
  </head>
  <body>
    <nav class="navbar navbar-pill" aria-label="Main">
      <div class="container navbar-container">
        <input type="checkbox" id="site-nav-toggle" class="navbar-offcanvas-toggle" />
        <label for="site-nav-toggle" class="navbar-offcanvas-backdrop"></label>

        <a href={withBase('/')} class="navbar-brand brand-lockup">
          <LogoMark size={32} />
          <span>{site.name}</span>
        </a>

        <label for="site-nav-toggle" class="navbar-toggle m-0"><span></span><span></span><span></span></label>

        <div class="navbar-menu navbar-menu-offcanvas">
          {nav.map((n) => (
            <a href={withBase(n.href)} class:list={['navbar-item', 'nav-bi', { 'is-active': n.href === path }]} aria-current={n.href === path ? 'page' : undefined}>
              <span class="nav-en">{n.label.en}</span><span class="nav-zh" lang="zh-Hant">{n.label.zh}</span>
            </a>
          ))}
          <a href={withBase('/contact/')} class="cta cta-sm"><Bi t={site.cta.book} inline /></a>
        </div>
      </div>
    </nav>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <div class="footer-grid">
          <div>
            <div class="brand-lockup" style="margin-bottom:1rem"><LogoMark size={34} /><span>{site.name}</span></div>
            <p class="muted-on-dark" style="max-width:36ch;margin:0"><Bi t={site.hero.lead} /></p>
          </div>
          <div>
            <h3>Explore<span class="zh" lang="zh-Hant">探索</span></h3>
            <ul>
              {nav.map((n) => <li><a href={withBase(n.href)}>{n.label.en} <span class="zh-inline-soft" lang="zh-Hant">{n.label.zh}</span></a></li>)}
            </ul>
          </div>
          <div>
            <h3>Contact us<span class="zh" lang="zh-Hant">聯絡我們</span></h3>
            <ul>
              <li><a href={telHref(site.phone)}>{site.phone}</a></li>
              <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
              <li class="muted-on-dark">{en(site.hours.label)}<span class="zh" lang="zh-Hant">{zh(site.hours.label)}</span></li>
            </ul>
          </div>
        </div>
        <div class="footer-base">
          <span>© {year} {site.name}</span>
          <span>{en(site.concept)} <span lang="zh-Hant">{zh(site.concept)}</span></span>
          <span>Imagery generated with AI. 圖片由 AI 生成。</span>
        </div>
      </div>
    </footer>

    <script is:inline defer src={`${vendor}/js/molique-script.js`}></script>
  </body>
</html>
