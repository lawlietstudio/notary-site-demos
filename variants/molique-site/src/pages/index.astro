---
import Layout from '../layouts/Layout.astro';
import Photo from '../components/Photo.astro';
import Icon from '../components/Icon.astro';
import PriceCards from '../components/PriceCards.astro';
import { en, faqs, site, withBase } from '../lib/site';

import heroBg from '../assets/ai/hero-bg.webp';
import affidavits from '../assets/ai/svc-affidavits.webp';
import envelope from '../assets/ai/trust-envelope.webp';
import travel from '../assets/ai/svc-travel.webp';
import declarations from '../assets/ai/svc-declarations.webp';
import claims from '../assets/ai/svc-claims.webp';
import skyline from '../assets/ai/skyline.webp';
import street from '../assets/ai/mobile-street.webp';
import silk from '../assets/ai/navy-silk.webp';
import dust from '../assets/ai/gold-dust.webp';
import seal from '../assets/ai/seal-3d.webp';

const tiles = [
  { img: affidavits, cls: 't1', alt: 'An affidavit form on a leather desk pad beside a fountain pen and a red wax seal' },
  { img: envelope, cls: 't2', alt: 'Two hands exchanging a sealed envelope' },
  { img: travel, cls: 't3', alt: 'A navy passport and a boarding pass on a walnut desk' },
  { img: declarations, cls: 't4', alt: 'A hand resting on a leather legal binder beside a brass stamp' },
  { img: claims, cls: 't5', alt: 'A signed claim form with a gold foil seal' },
  { img: skyline, cls: 't6', alt: 'A city skyline at blue hour reflected in a river' },
];
const icons = ['map-pin', 'clock', 'lock', 'coin'];
const words = en(site.hero.title).split(' ');
const lead = words.slice(0, -3).join(' ');
const accent = words.slice(-3).join(' ');
---
<Layout path="/">
  <section class="hero-cinema">
    <Photo class="hero-bg" src={heroBg} alt="A notary's hands signing and stamping a document at a walnut desk" widths={[800, 1200, 1600, 1920]} eager />
    <div class="container">
      <p class="eyebrow animate fade-in-up">{en(site.hero.eyebrow)}</p>
      <h1 class="animate fade-in-up">{lead} <em>{accent}</em></h1>
      <p class="hero-lead animate fade-in-up">{en(site.hero.lead)}</p>
      <div class="hero-actions animate fade-in-up">
        <a href={withBase('/contact/')} class="cta cta-lg">{en(site.cta.book)} <Icon name="arrow" size={16} /></a>
        <a href={withBase('/pricing/')} class="cta cta-ghost cta-lg">{en(site.cta.pricing)}</a>
      </div>
      <div class="hero-stats">
        <div class="counter"><div class="counter-value">7</div><div class="counter-title">days a week</div></div>
        <div class="counter"><div class="counter-value">{site.services.items.length}</div><div class="counter-title">document types</div></div>
        <div class="counter"><div class="counter-value">24</div><div class="counter-title">hours' cancellation notice</div></div>
      </div>
    </div>
  </section>

  <section class="block">
    <div class="container">
      <div class="block-head">
        <p class="eyebrow">Services</p>
        <h2>{en(site.services.title)}</h2>
        <p>{en(site.hero.lead)}</p>
      </div>
      <div class="bento">
        {site.services.items.map((s: any, i: number) => (
          <article class={`tile ${tiles[i].cls}`}>
            <Photo src={tiles[i].img} alt={tiles[i].alt} sizes="(min-width: 860px) 60vw, 100vw" widths={[480, 800, 1200]} />
            <div class="tile-body">
              <span class="tile-num">{String(i + 1).padStart(2, '0')}</span>
              <h3>{en(s.name)}</h3>
              <p>{en(s.example)}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="block" style="padding-top:0">
    <div class="container split">
      <div class="frame" style="min-height:30rem">
        <Photo src={street} alt="A professional in a dark overcoat carrying a briefcase walks to a front door at blue hour" sizes="(min-width: 900px) 560px, 100vw" widths={[480, 800, 1100]} />
      </div>
      <div>
        <p class="eyebrow">{en(site.why.title)}</p>
        <h2 class="serif-title">We come to <em>you.</em></h2>
        {site.why.items.map((w: any, i: number) => (
          <div class="feature">
            <span class="feature-icon"><Icon name={icons[i % icons.length]} size={22} /></span>
            <div>
              <h3>{en(w.title)}</h3>
              <p>{en(w.text)}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="block dark-block">
    <Photo class="section-bg" src={dust} alt="" widths={[800, 1200, 1600]} />
    <div class="container">
      <div class="block-head">
        <p class="eyebrow">{en(site.contact.stepsTitle)}</p>
        <h2>Three steps, one visit</h2>
      </div>
      <div class="steps">
        {site.contact.steps.map((st: any) => (
          <div class="step-card">
            <h3>{en(st.title)}</h3>
            <p>{en(st.text)}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="block dark-block bg-cinema">
    <div class="container">
      <div class="block-head">
        <p class="eyebrow">{en(site.pricing.payment)}</p>
        <h2>{en(site.pricing.title)}</h2>
      </div>
      <PriceCards />
    </div>
  </section>

  <section class="block">
    <div class="container">
      <div class="block-head">
        <p class="eyebrow">FAQ</p>
        <h2>Questions, answered</h2>
      </div>
      <div class="faq">
        {faqs.map((f) => (
          <details class="accordion-item" name="faq">
            <summary class="accordion-header"><span>{f.q}</span></summary>
            <div class="accordion-body"><p class="text-muted m-0">{f.a}</p></div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="dark-block cta-block">
    <Photo class="section-bg" src={silk} alt="" widths={[800, 1200, 1600]} />
    <div class="container">
      <Photo class="seal-float" src={seal} alt="A polished brass notary seal" widths={[320, 480, 640]} sizes="240px" />
      <h2>{en(site.ctaBand.title)}</h2>
      <p>{en(site.ctaBand.text)}</p>
      <a href={withBase('/contact/')} class="cta cta-lg">{en(site.cta.book)} <Icon name="arrow" size={16} /></a>
    </div>
  </section>
</Layout>
