---
import Layout from '../layouts/Layout.astro';
import Band from '../components/Band.astro';
import Bi from '../components/Bi.astro';
import Photo from '../components/Photo.astro';
import Icon from '../components/Icon.astro';
import { en, site, withBase } from '../lib/site';
import dust from '../assets/ai/gold-dust.webp';
import desk from '../assets/ai/about-desk.webp';
import home from '../assets/ai/home-visit.webp';

const about = site.about;
---
<Layout path="/about/" title="About" description={`${en(about.intro[0])} ${en(about.area.text)}`.slice(0, 200)}>
  <Band title={about.title} lead={about.intro[0]} img={dust} />

  <section class="block">
    <div class="container split">
      <div class="prose-wrap" style="margin:0">
        <p class="lead-p"><Bi t={about.intro[1]} /></p>

        <h2><Bi t={about.area.title} /></h2>
        <p><Bi t={about.area.text} /></p>

        <div class="callout">
          <h2 style="margin-top:0"><Bi t={about.proBono.title} /></h2>
          {about.proBono.paragraphs.map((p: any) => <p><Bi t={p} /></p>)}
        </div>

        <h2><Bi t={about.person.title} /></h2>
        {about.person.paragraphs.map((p: any) => <p><Bi t={p} /></p>)}

        <h2><Bi t={about.credentials.title} /></h2>
        <ul class="credentials">
          {about.credentials.items.map((c: string) => <li><Icon name="check" size={18} /> {c}</li>)}
        </ul>

        <p style="margin-top:2.5rem"><a href={withBase('/contact/')} class="cta cta-dark cta-lg"><Bi t={site.cta.book} inline /> <Icon name="arrow" size={16} /></a></p>
      </div>
      <div class="frame" style="min-height:40rem">
        <Photo src={desk} alt="A notary journal, fountain pen, brass seal and reading glasses on dark wood" sizes="(min-width: 900px) 520px, 100vw" widths={[480, 800, 1100]} />
      </div>
    </div>
  </section>

  <section class="block" style="padding-top:0">
    <div class="container">
      <div class="frame" style="min-height:22rem">
        <Photo src={home} alt="An open leather briefcase with documents on a kitchen table" sizes="100vw" widths={[800, 1200, 1600]} />
      </div>
    </div>
  </section>
</Layout>
