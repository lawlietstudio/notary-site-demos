---
import Layout from '../layouts/Layout.astro';
import Band from '../components/Band.astro';
import Photo from '../components/Photo.astro';
import { en, site, withBase } from '../lib/site';
import dust from '../assets/ai/gold-dust.webp';
import desk from '../assets/ai/about-desk.webp';
import home from '../assets/ai/home-visit.webp';

const about = site.about;
---
<Layout path="/about/" title="About" description={`About ${site.name}: ${en(about.intro[0])}`.slice(0, 200)}>
  <Band title={en(about.title)} lead={en(about.intro[0])} img={dust} />

  <section class="block">
    <div class="container split">
      <div class="prose-wrap" style="margin:0">
        <h2 style="margin-top:0">{en(about.area.title)}</h2>
        <p>{en(about.area.text)}</p>
        <h2>{en(about.person.title)}</h2>
        {about.person.paragraphs.map((p: any) => <p>{en(p)}</p>)}
        <h2>{en(about.credentials.title)}</h2>
        <ul class="list-icons list-icons-check">
          {about.credentials.items.map((c: string) => <li>{c}</li>)}
        </ul>
        <p style="margin-top:2rem"><a href={withBase('/contact/')} class="btn-primary btn-lg">{en(site.cta.book)}</a></p>
      </div>
      <div class="frame" style="min-height:36rem">
        <Photo src={desk} alt="A notary journal, fountain pen, brass seal and reading glasses on dark wood" sizes="(min-width: 900px) 520px, 100vw" widths={[480, 800, 1100]} />
      </div>
    </div>
  </section>

  <section class="block" style="padding-top:0">
    <div class="container">
      <div class="frame" style="min-height:20rem">
        <Photo src={home} alt="An open leather briefcase with documents on a kitchen table" sizes="100vw" widths={[800, 1200, 1600]} />
      </div>
    </div>
  </section>
</Layout>
