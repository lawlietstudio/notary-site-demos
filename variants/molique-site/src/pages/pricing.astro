---
import Layout from '../layouts/Layout.astro';
import Band from '../components/Band.astro';
import Bi from '../components/Bi.astro';
import PriceCards from '../components/PriceCards.astro';
import Photo from '../components/Photo.astro';
import Icon from '../components/Icon.astro';
import { en, site, withBase } from '../lib/site';
import silk from '../assets/ai/navy-silk.webp';
import dust from '../assets/ai/gold-dust.webp';
import seal from '../assets/ai/seal-3d.webp';
---
<Layout
  path="/pricing/"
  title="Price Plans"
  description={`${en(site.pricing.title)} (${en(site.pricing.payment).toLowerCase()}): ${site.pricing.plans.map((p: any) => `${en(p.name)} ${p.price}`).join(', ')}.`}
>
  <Band title={site.pricing.title} lead={site.pricing.payment} img={silk} />

  <section class="block dark-block bg-cinema" style="padding-top:clamp(3.5rem,7vw,6rem)">
    <div class="container">
      <PriceCards />
    </div>
  </section>

  <section class="block">
    <div class="container">
      <div class="block-head">
        <h2><Bi t={site.pricing.examplesTitle} /></h2>
      </div>
      <div class="grid grid-cols-1 grid-md-cols-3 gap-4">
        {site.services.items.map((s: any, i: number) => (
          <div class="card">
            <div class="card-body">
              <span class="tile-num" style="color:var(--gold-deep)">{String(i + 1).padStart(2, '0')}</span>
              <h3 style="margin:0.6rem 0 0.5rem;font-size:1.7rem"><Bi t={s.name} inline /></h3>
              <p class="text-muted m-0"><Bi t={s.example} /></p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="dark-block cta-block">
    <Photo class="section-bg" src={dust} alt="" widths={[800, 1200, 1600]} />
    <div class="container">
      <Photo class="seal-float" src={seal} alt="A polished brass notary seal" widths={[320, 480, 640]} sizes="240px" />
      <h2><Bi t={site.ctaBand.title} /></h2>
      <p><Bi t={site.ctaBand.text} /></p>
      <a href={withBase('/contact/')} class="cta cta-lg"><Bi t={site.cta.book} inline /> <Icon name="arrow" size={16} /></a>
    </div>
  </section>
</Layout>
