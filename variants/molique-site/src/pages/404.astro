---
import Layout from '../layouts/Layout.astro';
import Band from '../components/Band.astro';
import { withBase } from '../lib/site';
import silk from '../assets/ai/navy-silk.webp';
---
<Layout path="/404/" title="Page not found">
  <Band title={{ en: 'Page not found', zh: '找不到頁面' }} lead={{ en: 'The page you were looking for does not exist.', zh: '您要找的頁面不存在。' }} img={silk} />
  <section class="block" style="text-align:center">
    <div class="container">
      <a href={withBase('/')} class="cta cta-dark cta-lg">Back to home<span class="zh zh-inline" lang="zh-Hant">返回首頁</span></a>
    </div>
  </section>
</Layout>
