---
import Layout from '../layouts/Layout.astro';
import Band from '../components/Band.astro';
import { withBase } from '../lib/site';
import silk from '../assets/ai/navy-silk.webp';
---
<Layout path="/404/" title="Page not found">
  <Band title="Page not found" lead="The page you were looking for does not exist." img={silk} />
  <section class="block" style="text-align:center">
    <div class="container">
      <a href={withBase('/')} class="cta cta-dark cta-lg">Back to home</a>
    </div>
  </section>
</Layout>
