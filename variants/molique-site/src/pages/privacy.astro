---
import Layout from '../layouts/Layout.astro';
import Band from '../components/Band.astro';
import Bi from '../components/Bi.astro';
import { site } from '../lib/site';
import silk from '../assets/ai/navy-silk.webp';

const pv = site.privacy;
---
<Layout path="/privacy/" title="Privacy Policy" description={`How ${site.name} collects and uses personal information.`}>
  <Band title={pv.title} img={silk} />
  <section class="block">
    <div class="container prose-wrap">
      <p><Bi t={pv.intro} /></p>
      {pv.sections.map((s: any) => (
        <>
          <h2><Bi t={s.title} inline /></h2>
          <p><Bi t={s.text} /></p>
        </>
      ))}
      <p style="margin-top:2.5rem"><Bi t={pv.outro} /></p>
    </div>
  </section>
</Layout>
