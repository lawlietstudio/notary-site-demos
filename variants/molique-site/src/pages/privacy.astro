---
import Layout from '../layouts/Layout.astro';
import Band from '../components/Band.astro';
import { site, telHref } from '../lib/site';
import silk from '../assets/ai/navy-silk.webp';

const pv = site.privacy;
---
<Layout path="/privacy/" title="Privacy Policy" description={`How ${site.name} collects and uses personal information.`}>
  <Band title={pv.title} lead={`Last updated ${pv.lastUpdated}`} img={silk} />
  <section class="block">
    <div class="container prose-wrap">
      <p>{pv.intro}</p>
      {pv.sections.map((s: any) => (<><h2>{s.title}</h2><p>{s.text}</p></>))}
      <h2>Contact</h2>
      <p>Questions about this policy? Email <a href={`mailto:${site.email}`}>{site.email}</a> or call <a href={telHref(site.phone)}>{site.phone}</a>.</p>
    </div>
  </section>
</Layout>
