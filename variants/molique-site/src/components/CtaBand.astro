---
// Closing call-to-action: one full-bleed photograph, a hairline frame and centred copy.
// (No floating objects: they never sat naturally on the photograph behind them.)
import Photo from './Photo.astro';
import LogoMark from './LogoMark.astro';
import { href, site, t, telHref, type Lang } from '../lib/site';
import skyline from '../assets/ai/skyline.webp';

const { lang } = Astro.props as { lang: Lang };
---
<section class="cta-band">
  <Photo class="cta-img" src={skyline} alt="" widths={[800, 1200, 1600, 1920]} />
  <div class="cta-frame">
    <div class="container cta-copy reveal">
      <LogoMark size={44} class="cta-mark" />
      <h2>{t(site.ctaBand.title, lang)}</h2>
      <p>{t(site.ctaBand.text, lang)}</p>
      <div class="actions center">
        <a href={href('/contact/', lang)} class="btn btn-gold">{t(site.cta.book, lang)}<span class="arr" aria-hidden="true"></span></a>
        <a href={telHref(site.phone)} class="btn btn-line">{site.phone}</a>
      </div>
    </div>
  </div>
</section>
