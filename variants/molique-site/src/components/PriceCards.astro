---
import Bi from './Bi.astro';
import { site, withBase } from '../lib/site';
---
<div class="price-grid">
  {site.pricing.plans.map((p: any) => (
    <div class:list={['pricing-table', { 'is-featured': p.featured }]}>
      <div class="pricing-header">
        <div class="pricing-title"><Bi t={p.name} inline /></div>
        <div class="pricing-price">{p.price}{p.unit && <span><Bi t={p.unit} inline /></span>}</div>
        <p class="plan-desc"><Bi t={p.desc} /></p>
      </div>
      <a href={withBase('/contact/')} class:list={['cta', 'cta-full', { 'cta-ghost': !p.featured }]}><Bi t={site.cta.book} inline /></a>
    </div>
  ))}
</div>
