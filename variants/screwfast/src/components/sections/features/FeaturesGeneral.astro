---
// Import the necessary dependencies
import { Image } from 'astro:assets';
import IconBlock from '@components/ui/blocks/IconBlock.astro';
import Icon from '@components/ui/icons/Icon.astro';
import { assertIconName } from '@components/ui/icons/icons';

interface Feature {
  heading: string;
  content: string;
  /** An `IconName`; JSON data cannot carry the type, so it is checked at render. */
  svg: string;
}

interface Props {
  title?: string;
  subTitle?: string;
  features?: Feature[];
  src?: any;
  alt?: string;
}
// Define props from Astro
const { title, subTitle, src, alt, features } = Astro.props;
const hasImage = Boolean(src && alt);
---

<section class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14 2xl:max-w-full">
  {/* Image on the left, content on the right (stacked on small screens) */}
  <div class="grid items-center gap-8 lg:grid-cols-5 lg:gap-14">
    {hasImage && (
      <div class="overflow-hidden rounded-2xl lg:col-span-2">
        <Image
          src={src}
          alt={alt}
          width={900}
          height={1020}
          class="aspect-[4/3] w-full object-cover object-center sm:aspect-[16/10] lg:aspect-[4/5]"
          draggable={'false'}
          format={'avif'}
          loading="lazy"
        />
      </div>
    )}

    <div class={hasImage ? 'lg:col-span-3' : 'lg:col-span-5'}>
      {/* Title and subtitle */}
      <h2 class="text-2xl font-bold text-balance text-neutral-800 md:text-3xl dark:text-neutral-200">
        {title}
      </h2>
      {subTitle && (
        <p class="mt-2 text-pretty text-neutral-600 md:mt-4 dark:text-neutral-400">
          {subTitle}
        </p>
      )}

      {/* The IconBlock components */}
      <div class="mt-8 grid gap-8 sm:grid-cols-2 md:gap-10">
        {features &&
          features.map(feature => (
            <IconBlock heading={feature.heading} content={feature.content}>
              <Icon
                name={assertIconName(feature.svg)}
                class="mt-1 h-8 w-8 shrink-0 text-orange-400 dark:text-orange-300"
              />
            </IconBlock>
          ))}
      </div>
    </div>
  </div>
</section>
